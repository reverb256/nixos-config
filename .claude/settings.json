{
  "permissions": {
    "additionalDirectories": [
      "/data/@projects/infra/xnm1-upgrade-worktree/"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "pattern": ".*hardware-configuration\\.nix.*",
        "action": "block",
        "message": "hardware-configuration.nix is auto-generated by nixos-generate-config. Edit configuration.nix or modules/ instead."
      }
    ],
    "PostToolUse": [
      {
        "pattern": ".*(Write|Edit).*\\.nix$",
        "command": "nix flake check",
        "timeout": 30000,
        "includeToolOutput": false
      }
    ]
  }
}
