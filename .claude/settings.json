{
  "permissions": {
    "additionalDirectories": [
      "/data/@projects/infra/xnm1-upgrade-worktree/"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": {
          "tools": ["Edit", "Write"],
          "patterns": [".*hardware-configuration\\.nix.*"]
        },
        "hooks": [
          {
            "type": "block",
            "message": "hardware-configuration.nix is auto-generated by nixos-generate-config. Edit configuration.nix or modules/ instead."
          }
        ]
      },
      {
        "matcher": {
          "tools": ["Edit", "Write"],
          "patterns": [".*flake\\.lock.*"]
        },
        "hooks": [
          {
            "type": "block",
            "message": "flake.lock is auto-managed. Run 'nix flake update' to update inputs."
          }
        ]
      },
      {
        "matcher": {
          "tools": ["Edit", "Write"],
          "patterns": [".*modules/default\\.nix.*"]
        },
        "hooks": [
          {
            "type": "warn",
            "message": "Editing modules/default.nix affects ALL 4 hosts (zephyr, forge, nexus, sentry). Consider using enable options instead."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": {
          "tools": ["Edit", "Write"],
          "patterns": [".*\\.nix$"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "nix flake check"
          }
        ]
      }
    ]
  }
}
