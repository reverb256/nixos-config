 niri-ipc/src/lib.rs       | 10 ++++++++++
 src/backend/tty.rs        | 94 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 src/niri.rs               |  7 +++++++
 4 files changed, 117 insertions(+)

