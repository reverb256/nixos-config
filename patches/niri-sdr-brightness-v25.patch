 /// Output mode to set.
diff --git a/src/backend/tty.rs b/src/backend/tty.rs
index 4444444..5555555 100644
--- a/src/backend/tty.rs
+++ b/src/backend/tty.rs
@@ -250,6 +250,13 @@ struct GammaProps {
     previous_blob: Option<NonZeroU64>,
 }
 
+/// NVIDIA SDR brightness plane property (NV_PLANE_DEGAMMA_MULTIPLIER).
+/// A 32.32 fixed-point multiplier applied to the composited image, giving
+/// hardware-accelerated brightness control for displays without DDC/CI.
+struct NvBrightnessProps {
+    crtc: crtc::Handle,
+    degamma_mult: property::Handle,
+}
+
 struct ConnectorProperties<'a> {
     device: &'a DrmDevice,
     connector: connector::Handle,
@@ -1768,6 +1775,44 @@ impl Tty {
         self.refresh_ipc_outputs(niri);
     }
 
+    /// Detect the NV_PLANE_DEGAMMA_MULTIPLIER property on the primary plane
+    /// that can drive this CRTC, returning an `NvBrightnessProps` if present.
+    fn detect_nv_brightness_props(
+        drm: &DrmDevice,
+        crtc: crtc::Handle,
+    ) -> Option<NvBrightnessProps> {
+        let plane_handles = drm.planes().ok()?;
+        for plane_handle in plane_handles {
+            let info = drm.get_plane_info(plane_handle).ok()?;
+            // Only primary planes that can drive this CRTC.
+            if info.crtc != Some(crtc) {
+                continue;
+            }
+            if let Some(prop) = find_drm_property(drm, plane_handle, "NV_PLANE_DEGAMMA_MULTIPLIER") {
+                debug!(
+                    "found NV_PLANE_DEGAMMA_MULTIPLIER on plane {:?} for CRTC {:?}",
+                    plane_handle, crtc
+                );
+                return Some(NvBrightnessProps {
+                    crtc,
+                    degamma_mult: prop.handle,
+                });
+            }
+        }
+        None
+    }
+
+    /// Write the SDR brightness multiplier to the plane property.
+    fn set_nv_brightness(
+        &self,
+        device: &DrmDevice,
+        crtc: crtc::Handle,
+        brightness: f64,
+    ) -> anyhow::Result<()> {
+        let props = Self::detect_nv_brightness_props(device, crtc)
+            .context("NV_PLANE_DEGAMMA_MULTIPLIER not available on this output")?;
+        // 32.32 fixed point: value 1.0 -> 0x100000000.
+        let fixed = (brightness.clamp(0.0, 1.0) * 4294967296.0).round() as u64;
+        device
+            .connection()
+            .set_property(crtc, props.degamma_mult, fixed)
+            .context("error setting NV_PLANE_DEGAMMA_MULTIPLIER")?;
+        Ok(())
+    }
+
+    /// Resolve the device + CRTC for an `Output` and apply SDR brightness.
+    fn set_nv_brightness_for_output(
+        &self,
+        output: &Output,
+        brightness: f64,
+    ) -> anyhow::Result<()> {
+        for device in self.devices.values() {
+            for (&crtc, surface) in device.surfaces.iter() {
+                let tty_state: &TtyOutputState = output.user_data().get().unwrap();
+                if tty_state.node == surface.name.node() && tty_state.crtc == crtc {
+                    return self.set_nv_brightness(&device.drm, crtc, brightness);
+                }
+            }
+        }
+        anyhow::bail!("no surface found for output {:?}", output.name())
+    }
+
     pub fn on_output_config_changed(&mut self, niri: &mut Niri) {
         let _span = tracy_client::span!("Tty::on_output_config_changed");
 
@@ -1853,6 +1898,15 @@ impl Tty {
                 } else {
                     warn!("failed to get connector properties");
                 };
 
+                // Apply SDR brightness via NV_PLANE_DEGAMMA_MULTIPLIER when configured.
+                if let Some(brightness) = config.sdr_brightness {
+                    if let Err(err) = self.set_nv_brightness(&device.drm, crtc, brightness) {
+                        debug!(
+                            "output {:?}: SDR brightness not applied: {err:?}",
+                            surface.name.connector
+                        );
+                    }
+                }
+
                 // Check if we need to change the mode.
                 let Some(connector) = device.drm_scanner.connectors().get(&surface.connector)
                 else {
diff --git a/src/niri.rs b/src/niri.rs
index 6666666..7777777 100644
--- a/src/niri.rs
+++ b/src/niri.rs
@@ -1772,6 +1772,13 @@ impl Tty {
             niri_ipc::OutputAction::Vrr { vrr } => {
                 config.variable_refresh_rate = if vrr.vrr {
                     Some(niri_config::Vrr {
                         on_demand: vrr.on_demand,
                     })
                 } else {
                     None
                 }
             }
+            niri_ipc::OutputAction::SdrBrightness { brightness } => {
+                config.sdr_brightness = Some(brightness.clamp(0.0, 1.0));
+                // Apply immediately via the tty backend.
+                if let Some(tty) = self.backend.tty_checked() {
+                    let _ = tty.set_nv_brightness_for_output(&surface, brightness);
+                }
+            }
         });
 
         self.reload_output_config();
