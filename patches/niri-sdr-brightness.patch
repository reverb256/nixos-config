+    /// Write the SDR brightness multiplier to the NV_PLANE_DEGAMMA_MULTIPLIER
+    /// plane property for the output's CRTC.
+    pub fn set_sdr_brightness(&self, output: &Output, brightness: f64) -> anyhow::Result<()> {
+        let brightness = brightness.clamp(0.0, 1.0);
+        for (&node, device) in self.devices.iter() {
+            for (&crtc, surface) in device.surfaces.iter() {
+                let tty_state: &TtyOutputState = output.user_data().get().unwrap();
+                if tty_state.node == node && tty_state.crtc == crtc {
+                    return self.apply_nv_brightness(&device.drm, crtc, brightness);
+                }
+            }
+        }
+        anyhow::bail!("no surface found for output {:?}", output.name())
+    }
+
+    fn apply_nv_brightness(
+        &self,
+        drm: &DrmDevice,
+        crtc: crtc::Handle,
+        brightness: f64,
+    ) -> anyhow::Result<()> {
+        let props = Self::detect_nv_brightness_props(drm, crtc)
+            .context("NV_PLANE_DEGAMMA_MULTIPLIER not available on this output")?;
+        // 32.32 fixed point: value 1.0 -> 0x100000000.
+        let fixed = (brightness.clamp(0.0, 1.0) * 4294967296.0).round() as u64;
+        drm.set_property(crtc, props.degamma_mult, fixed)
+            .context("error setting NV_PLANE_DEGAMMA_MULTIPLIER")?;
+        Ok(())
+    }
+
+    fn detect_nv_brightness_props(drm: &DrmDevice, crtc: crtc::Handle) -> Option<NvBrightnessProps> {
+        let plane_handles = drm.planes().ok()?;
+        for plane_handle in plane_handles {
+            let info = drm.get_plane_info(plane_handle).ok()?;
+            if info.crtc != Some(crtc) {
+                continue;
+            }
+            if let Some((_, _info, _value)) =
+                find_drm_property(drm, plane_handle, "NV_PLANE_DEGAMMA_MULTIPLIER")
+            {
+                debug!(
+                    "found NV_PLANE_DEGAMMA_MULTIPLIER on plane {:?} for CRTC {:?}",
+                    plane_handle, crtc
+                );
+                return Some(NvBrightnessProps {
+                    crtc,
+                    degamma_mult: _info.handle,
+                });
+            }
+        }
+        None
+    }
