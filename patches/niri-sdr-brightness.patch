-        let layer_popup_under = |layer| {
-            layers
-                .layers_on(layer)
-                .rev()
-                .find_map(|layer_surface| {
-                    let mapped = self.mapped_layer_surfaces.get(layer_surface)?;
-                    if mapped.place_within_backdrop() {
-                        return None;
