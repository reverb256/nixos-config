# Local environment overrides - add to .envrc.local to override settings locally
# This file should NOT be committed to the repository
# Copy this to .envrc.local and customize as needed

# Example local overrides:
# export CUSTOM_HOSTNAME="my-personal-host"
# export DEVELOPMENT_MODE="true"
# export DEBUG_LEVEL="verbose"

# Personal SSH key for deployments
# export SSH_KEY_PATH="$HOME/.ssh/my-key"

# Additional Nix substituters (caches)
# export NIX_SUBSTITUTERS="$NIX_SUBSTITUTERS https://my-cache.example.com"

# Personal development settings
# export COLMENA_TARGETS="zephyr"  # Only deploy to local host during development

# ============================================================================
#  DEVELOPMENT
# ============================================================================

# Skip  deployment during local development
# export SKIP_="true"

# Use custom  image for development
# export _IMAGE="ghcr.io//:dev"

# ============================================================================
# VR/WIVRN DEVELOPMENT
# ============================================================================

# Enable VR mode for local testing
# export VR_ENABLED="true"

# WiVRn client mode (connect to remote server)
# export WIVRN_CLIENT_MODE="true"
# export WIVRN_SERVER_IP="10.1.1.110"