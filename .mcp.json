{
  "mcpServers": {
    "filesystem": {
      "command": "mcp-filesystem",
      "args": [
        "/etc/nixos",
        "/home/j_kro"
      ]
    },
    "git": {
      "command": "mcp-git"
    },
    "fetch": {
      "command": "mcp-fetch"
    },
    "context7": {
      "command": "mcp-context7"
    },
    "grep-app": {
      "command": "mcp-grep-app"
    },
    "chrome-devtools": {
      "command": "mcp-chrome-devtools"
    },
    "playwright": {
      "command": "mcp-playwright"
    },
    "nixos": {
      "command": "uvx",
      "args": [
        "mcp-nixos"
      ]
    },
    "gateway": {
      "command": "mcp-gateway-bridge",
      "env": {
        "GATEWAY_URL": "http://ai.cluster.local"
      }
    },
    "searxng": {
      "command": "/etc/nixos/modules/services/ai-inference/bin/searxng-mcp-wrapper",
      "env": {
        "SEARXNG_URL": "http://searxng.search.svc.cluster.local:8080"
      }
    }
  }
}
