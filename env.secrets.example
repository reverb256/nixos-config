GARAGE_SECRET_KEY=replace-me-locally
RESTIC_REPO_PASSWORD=replace-me-locally
RCLONE_CONFIG_PASS=replace-me-locally
# Allowed through dotenv (not keyring). Remove when sops:// routes are live.
BACKUP_ENCRYPTION_KEY=replace-me-locally

# === Kubernetes =============================================================
K3S_CLUSTER_TOKEN=replace-me-locally
KUBECONFIG_ADMIN=replace-me-locally
KUBEADMIN_PASSWORD=replace-me-locally
K3S_KUBELET_TOKEN=replace-me-locally

# === Mining =================================================================
# Wallet keys (ETHEREUM_WALLET_KEY, MONERO_WALLET_KEY) deliberately absent:
# see sops-provider-design.md "Wallet key blocklist". They never route through
# dotenv or OS keyring; sops:// in Phase 2 or onepassword:// for daily-use.
MINING_POOL_USER=replace-me-locally
MINING_POOL_PASS=replace-me-locally
ETHEREUM_WALLET_ADDRESS=replace-me-locally
MONERO_WALLET_ADDRESS=replace-me-locally

