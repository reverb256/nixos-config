{
	"theme": "catppuccin-mocha",
	"packages": ["npm:pi-subdir-context@1.1.2", "npm:pi-secret-guard@1.2.15"],
	"compaction": {
		"enabled": true,
		"reserveTokens": 16384,
		"keepRecentTokens": 20000
	},
	"retry": {
		"enabled": true,
		"maxRetries": 3,
		"baseDelayMs": 2000,
		"maxDelayMs": 60000
	},
	"doubleEscapeAction": "tree",
	"treeFilterMode": "default"
}
