{
	"theme": "catppuccin-mocha",
	"packages": [
		"npm:pi-lens@3.8.5",
		"npm:pi-btw@0.2.1",
		"npm:@ifi/oh-pi-themes@0.4.4",
		"npm:@ifi/oh-pi@0.4.4",
		"npm:pi-rewind@0.5.0",
		"npm:pi-web-access@0.10.6",
		"npm:pi-show-diffs@0.2.7",
		"npm:pi-worktree@1.3.3",
		"npm:pi-subagents@0.12.4",
		"npm:pi-context@1.1.2",
		"npm:pi-annotated-reply@0.4.1",
		"npm:pi-subdir-context@1.1.2",
		"npm:pi-powerline-footer@0.4.9",
		"npm:pi-secret-guard@1.2.15",
		"npm:pi-teams@0.9.14",

		"npm:@samfp/pi-memory@0.2.0",
		"npm:@codexstar/pi-listen@5.0.7",
		"npm:hive-agent@0.5.5",
		"npm:pi-dj@3.2.1",
		"npm:@malinamnam/pi-phone@0.0.13",
		"git:github.com/PSU3D0/pi-dcp"
	],
	"compaction": {
		"enabled": true,
		"reserveTokens": 16384,
		"keepRecentTokens": 20000
	},
	"retry": {
		"enabled": true,
		"maxRetries": 3,
		"baseDelayMs": 2000,
		"maxDelayMs": 60000
	},
	"doubleEscapeAction": "tree",
	"treeFilterMode": "default",
	"onetool": {
		"command": "onetool",
		"args": [
			"--config",
			"/etc/nixos/.pi/onetool.yaml",
			"--secrets",
			"/etc/nixos/.pi/secrets.yaml"
		]
	}
}
