{
	"theme": "catppuccin-mocha",
	"packages": [
		"npm:pi-lens@3.8.5",
		"npm:pi-web-access@0.10.6",
		"npm:pi-worktree@1.3.3",
		"npm:pi-subagents@0.12.4",
		"npm:pi-context@1.1.2",
		"npm:pi-subdir-context@1.1.2",
		"npm:pi-secret-guard@1.2.15",
		"npm:pi-teams@0.9.14",
		"npm:hive-agent@0.5.5",
		"git:github.com/PSU3D0/pi-dcp"
	],
	"compaction": {
		"enabled": true,
		"reserveTokens": 16384,
		"keepRecentTokens": 20000
	},
	"retry": {
		"enabled": true,
		"maxRetries": 3,
		"baseDelayMs": 2000,
		"maxDelayMs": 60000
	},
	"doubleEscapeAction": "tree",
	"treeFilterMode": "default"
}
