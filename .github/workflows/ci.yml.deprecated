name: "NixOS Configuration CI"

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  # Build and test the configuration
  build:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        system: [x86_64-linux, aarch64-linux]
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Install Nix
      uses: DeterminateSystems/nix-installer-action@main
    
    - name: Setup Magic Nix Cache
      uses: DeterminateSystems/magic-nix-cache-action@main

    - name: Check flake
      run: nix flake check --all-systems

    - name: Build configuration
      run: |
        nix build .#nixosConfigurations.zephyr.config.system.build.toplevel
        nix build .#nixosConfigurations.nexus.config.system.build.toplevel
        nix build .#nixosConfigurations.forge.config.system.build.toplevel
        nix build .#nixosConfigurations.sentry.config.system.build.toplevel

  # Test colmena deployment
  deploy-test:
    runs-on: ubuntu-latest
    needs: build
    if: github.ref == 'refs/heads/main'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Install Nix
      uses: DeterminateSystems/nix-installer-action@main
    
    - name: Dry-run colmena deployment
      run: |
        nix run github:zhaofengli/colmena -- --dry-build