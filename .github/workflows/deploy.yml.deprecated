name: "Deploy to NixOS Cluster"

on:
  workflow_dispatch:  # Allows manual triggering
  push:
    branches: [ "main" ]
    paths:
      - '**.nix'
      - '**.toml'
      - '!.github/**'  # Exclude GitHub Actions changes from auto-triggering

concurrency:
  group: ${{ github.ref }}
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: self-hosted  # Use self-hosted runner for SSH access to nodes
    if: github.ref == 'refs/heads/main'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0  # Full history for colmena

    - name: Install Nix
      uses: DeterminateSystems/nix-installer-action@main

    - name: Setup Magic Nix Cache
      uses: DeterminateSystems/magic-nix-cache-action@main

    - name: Verify SSH access to cluster nodes
      run: |
        echo "Testing SSH connectivity to cluster nodes..."
        for host in zephyr nexus forge sentry; do
          ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no $host "hostname" || echo "Failed to connect to $host"
        done

    - name: Deploy using Colmena
      run: |
        # Set up SSH agent with deploy key
        eval $(ssh-agent)
        
        # Add the deploy key (stored as GitHub secret)
        echo "${{ secrets.CLUSTER_DEPLOY_KEY }}" | tr -d '\r' | ssh-add -
        
        # Run colmena deployment
        nix run github:zhaofengli/colmena -- deploy --on-change build
        
        # Clean up
        ssh-agent -k

    - name: Verify deployment
      run: |
        # Check that all nodes are running the expected configuration
        for host in zephyr nexus forge sentry; do
          echo "Checking $host..."
          ssh $host "nixos-version"
        done

  notify-success:
    needs: deploy
    runs-on: ubuntu-latest
    if: success()
    
    steps:
    - name: Notify success
      run: |
        echo "✅ Deployment successful!"
        # Add notification to Discord/Slack/other here if needed

  notify-failure:
    needs: deploy
    runs-on: ubuntu-latest
    if: failure()
    
    steps:
    - name: Notify failure
      run: |
        echo "❌ Deployment failed!"
        # Add notification to Discord/Slack/other here if needed