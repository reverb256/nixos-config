{
  "dashboard": {
    "title": "Gaming Detection",
    "tags": ["gaming", "mining", "gpu"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Current Gaming State",
        "type": "stat",
        "targets": [
          {
            "expr": "gaming_active",
            "legendFormat": "{{host}} - {{detection_method}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "red", "value": 1}
              ]
            },
            "mappings": [
              {"type": "value", "value": "0", "text": "No Gaming"},
              {"type": "value", "value": "1", "text": "🎮 Gaming"}
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Gaming Sessions Today",
        "type": "graph",
        "targets": [
          {
            "expr": "gaming_active",
            "legendFormat": "{{host}}",
            "refId": "B"
          }
        ],
        "description": "Gaming sessions over time (1 = gaming active, 0 = not gaming)"
      },
      {
        "id": 3,
        "title": "Detection Method Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "count by (detection_method) (gaming_active == 1)",
            "refId": "C"
          }
        ],
        "description": "Distribution of detection methods (gamemode vs gpu_fallback)"
      }
    ]
  },
  "overwrite": true
}
