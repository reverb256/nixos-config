# =============================================================================
# Kubernetes Kubeconfig - Admin User
# =============================================================================
#
# Purpose: Admin kubeconfig for cluster management
#
# Usage:
#   1. Decrypt to generate actual kubeconfig
#   2. Copy to ~/.kube/config
#   3. Use with kubectl
#
# Template - Replace placeholders after generating certificates
# -----------------------------------------------------------------------------
apiVersion: v1
kind: Config
clusters:
  - name: homelab
    cluster:
      server: https://10.1.1.100:6443
      certificate-authority-data: BASE64_ENCODED_CA_PEM
users:
  - name: admin
    user:
      client-certificate-data: BASE64_ENCODED_ADMIN_PEM
      client-key-data: BASE64_ENCODED_ADMIN_KEY_PEM
contexts:
  - name: admin@homelab
    context:
      cluster: homelab
      user: admin
current-context: admin@homelab
