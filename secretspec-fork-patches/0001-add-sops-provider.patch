+//! SOPS provider — `sops://<file>` scheme via NDJSON stdio subprocess dispatch
+//! per cachix/secretspec#98 Secret Provider Protocol v1.
+//!
+//! Spawns `secretspec-provider-sops-protocol` (built from
+//! /home/j_kro/Projects/secretspec/provider-rust/) as a long-running subprocess;
+//! per-secret `get(addr)` writes one NDJSON request to stdin and reads the
+//! matching response from stdout. The handshake (`hello`) runs lazily on the
+//! first dispatch, keeping `SopsProvider::new` cheap and side-effect-free.
+//!
+//! Spec compliance:
+//! - Spec §5.1: missing keys return `value: null` (NOT error). `get()`
+//!   collapses this to `Ok(None)` uniformly — the wire envelope we re-shape
+//!   here is also re-shaped by the dispatcher (provider-rust main.rs returns
+//!   `value:null` on sops subprocess miss) so this branch is defence in
+//!   depth, not normally exercised.
+//! - Spec §6: dispatcher error envelope `{ok:false, error:{kind,message}}`
+//!   is mapped to `SecretSpecError::ProviderOperationFailed`. The one
+//!   exception is `kind = not_found` which we re-route to a clean null
+//!   envelope so the caller's value-extraction path sees a regular miss.
+//! - Spec §4: `sops://./relative.yaml` is host="." + path="/relative.yaml"
+//!   → "./relative.yaml" via concatenated `host + path` join, preserved
+//!   through `SopsConfig::try_from`.
+
+use super::{Address, Provider, ProviderUrl};
+use crate::{Result, SecretSpecError};
+use secrecy::SecretString;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value as JsonValue};
+use std::process::Stdio;
+use std::sync::{Mutex, MutexGuard};
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::process::{Child, ChildStdin, ChildStdout, Command};
+
+const PROTOCOL_VERSION: u32 = 1;
+const ENV_DISPATCHER_BIN: &str = "SECRETSPEC_SOPS_PROVIDER_BIN";
+const DEFAULT_DISPATCHER_BIN: &str = "secretspec-provider-sops-protocol";
+const DISPATCHER_GRACE_SECS: u64 = 5;
+
+/// Recover from a poisoned Mutex by extracting the inner value. Used
+/// in Drop and dispatch paths so a panic in a previous Mutex holder
+/// doesn't cascade into another panic during shutdown.
+fn recover_lock<'a, T>(guard: std::sync::LockResult<MutexGuard<'a, T>>) -> MutexGuard<'a, T> {
+    guard.unwrap_or_else(|p| p.into_inner())
+}
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct SopsConfig {
+    pub path: Option<String>,
+    pub default_key: Option<String>,
+    pub dispatcher_binary: Option<String>,
+}
+
+impl TryFrom<&ProviderUrl> for SopsConfig {
+    type Error = SecretSpecError;
+
+    fn try_from(url: &ProviderUrl) -> std::result::Result<Self, Self::Error> {
+        if url.scheme() != "sops" {
+            return Err(SecretSpecError::ProviderOperationFailed(format!(
+                "Invalid scheme '{}' for sops provider",
+                url.scheme()
+            )));
+        }
+        let host = url.host().unwrap_or_default();
+        let path = url.path();
+        let path_str = if host.is_empty() {
+            path.to_string()
+        } else if path == "/" || path.is_empty() {
+            host
+        } else {
+            format!("{}{}", host, path)
+        };
+        let normalized = if path_str.is_empty() || path_str == "/" {
+            None
+        } else {
+            Some(path_str)
+        };
+        Ok(Self {
+            path: normalized,
+            default_key: url.query_value("key"),
+            dispatcher_binary: url.query_value("binary"),
+        })
+    }
+}
+
+struct SubprocessHandle {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+pub struct SopsProvider {
+    config: SopsConfig,
+    handle: Mutex<Option<SubprocessHandle>>,
+}
+
+crate::register_provider! {
+    struct: SopsProvider,
+    config: SopsConfig,
+    name: "sops",
+    description: "SOPS-encrypted files via NDJSON stdio subprocess per cachix/secretspec#98 Secret Provider Protocol v1",
+    schemes: ["sops"],
+    examples: [
+        "sops:///etc/nixos/secrets/ai/nvidia-api-key.yaml",
+        "sops://./secrets.yaml?key=MIXED_CASE_KEY",
+        "sops://./secrets.yaml?binary=/usr/local/bin/secretspec-provider-sops-protocol",
+    ],
+}
+
+impl SopsProvider {
+    pub fn new(config: SopsConfig) -> Self {
+        Self { config, handle: Mutex::new(None) }
+    }
+
+    fn dispatcher_binary(&self) -> String {
+        self.config.dispatcher_binary.clone()
+            .or_else(|| std::env::var(ENV_DISPATCHER_BIN).ok())
+            .unwrap_or_else(|| DEFAULT_DISPATCHER_BIN.to_string())
+    }
+
+    fn spawn_subprocess(&self) -> Result<SubprocessHandle> {
+        let bin = self.dispatcher_binary();
+        let mut child = Command::new(&bin)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .map_err(|e| SecretSpecError::ProviderOperationFailed(format!("spawn '{}': {}", bin, e)))?;
+        let stdin = child
+            .stdin
+            .take()
+            .ok_or_else(|| SecretSpecError::ProviderOperationFailed("subprocess stdin missing".into()))?;
+        let stdout = child
+            .stdout
+            .take()
+            .ok_or_else(|| SecretSpecError::ProviderOperationFailed("subprocess stdout missing".into()))?;
+        Ok(SubprocessHandle { child, stdin, stdout: BufReader::new(stdout) })
+    }
+
+    /// NDJSON handshake: send `hello`, await + validate the response envelope.
+    async fn handshake(&self, handle: &mut SubprocessHandle) -> Result<()> {
+        let hello = json!({
+            "op": "hello",
+            "protocol_version": PROTOCOL_VERSION,
+            "uri": self.uri(),
+            "config_file": self.config.path,
+            "context": {},
+        });
+        let hello_str = format!("{}\n", hello);
+        handle.stdin.write_all(hello_str.as_bytes()).await.map_err(|e| {
+            SecretSpecError::ProviderOperationFailed(format!("hello write: {}", e))
+        })?;
+        handle.stdin.flush().await.map_err(|e| {
+            SecretSpecError::ProviderOperationFailed(format!("hello flush: {}", e))
+        })?;
+        let mut line = String::new();
+        let n = handle.stdout.read_line(&mut line).await.map_err(|e| {
+            SecretSpecError::ProviderOperationFailed(format!("hello read: {}", e))
+        })?;
+        if n == 0 {
+            return Err(SecretSpecError::ProviderOperationFailed("dispatcher EOF during handshake".into()));
+        }
+        let resp: JsonValue = serde_json::from_str(line.trim()).map_err(|e| {
+            SecretSpecError::ProviderOperationFailed(format!("hello response parse: {}", e))
+        })?;
+        if resp.get("ok").and_then(|v| v.as_bool()) != Some(true) {
+            return Err(SecretSpecError::ProviderOperationFailed(format!("handshake rejected: {}", line)));
+        }
+        if resp.get("protocol_version").and_then(|v| v.as_u64()) != Some(PROTOCOL_VERSION as u64) {
+            return Err(SecretSpecError::ProviderOperationFailed("dispatcher protocol_version mismatch".into()));
+        }
+        if resp.get("name").and_then(|v| v.as_str()) != Some("sops") {
+            return Err(SecretSpecError::ProviderOperationFailed(format!(
+                "dispatcher advertised name != sops: got {}",
+                line
+            )));
+        }
+        Ok(())
+    }
+
+    /// Send one request, await one response. EOF / parse-error signals the
+    /// dispatcher died; `dispatch()` uses this to trigger one restart.
+    async fn send_recv(&self, handle: &mut SubprocessHandle, request: &str) -> Result<JsonValue> {
+        handle.stdin.write_all(request.as_bytes()).await.map_err(|e| {
+            SecretSpecError::ProviderOperationFailed(format!("stdin write (subprocess-died): {}", e))
+        })?;
+        handle.stdin.flush().await.map_err(|e| {
+            SecretSpecError::ProviderOperationFailed(format!("stdin flush (subprocess-died): {}", e))
+        })?;
+        let mut line = String::new();
+        let n = handle.stdout.read_line(&mut line).await.map_err(|e| {
+            SecretSpecError::ProviderOperationFailed(format!("stdout read (subprocess-died): {}", e))
+        })?;
+        if n == 0 {
+            return Err(SecretSpecError::ProviderOperationFailed("dispatcher EOF mid-request".into()));
+        }
+        let resp: JsonValue = serde_json::from_str(line.trim()).map_err(|e| {
+            SecretSpecError::ProviderOperationFailed(format!("response parse: {}", e))
+        })?;
+        if let Some(false) = resp.get("ok").and_then(|v| v.as_bool()) {
+            let kind = resp.get("error").and_then(|e| e.get("kind")).and_then(|v| v.as_str()).unwrap_or("unknown");
+            let msg = resp.get("error").and_then(|e| e.get("message")).and_then(|v| v.as_str()).unwrap_or("unknown");
+            return match kind {
+                "not_found" => Ok(json!({ "ok": true, "value": null })),
+                _ => Err(SecretSpecError::ProviderOperationFailed(format!("{}: {}", kind, msg))),
+            };
+        }
+        Ok(resp)
+    }
+
+    /// Send `request`. Up to two attempts: re-spawn on the first failure.
+    /// Lock via poison-recovery helper so a prior-panic doesn't cascade.
+    async fn dispatch(&self, request: JsonValue) -> Result<JsonValue> {
+        let req_str = format!("{}\n", request);
+        let mut guard = recover_lock(self.handle.lock());
+        for restart_attempt in 0..2 {
+            if guard.is_none() {
+                *guard = Some(self.spawn_subprocess()?);
+                if let Err(e) = self.handshake(guard.as_mut().unwrap()).await {
+                    *guard = None;
+                    if restart_attempt == 0 { continue; }
+                    return Err(e);
+                }
+            }
+            match self.send_recv(guard.as_mut().unwrap(), &req_str).await {
+                Ok(resp) => return Ok(resp),
+                Err(e) => {
+                    *guard = None;
+                    if restart_attempt == 0 { continue; }
+                    return Err(SecretSpecError::ProviderOperationFailed(format!(
+                        "dispatcher-failed-twice: {}",
+                        e
+                    )));
+                }
+            }
+        }
+        unreachable!("dispatch loop exited without return")
+    }
+}
+
+impl Provider for SopsProvider {
+    fn convention_address(
+        &self,
+        _project: &str,
+        _profile: &str,
+        key: &str,
+    ) -> Result<crate::config::NativeAddress> {
+        Ok(crate::config::NativeAddress {
+            item: self.config.default_key.clone().unwrap_or_else(|| key.to_string()),
+            ..Default::default()
+        })
+    }
+
+    fn name(&self) -> &'static str { Self::PROVIDER_NAME }
+
+    fn uri(&self) -> String {
+        format!("sops://{}", self.config.path.as_deref().unwrap_or(""))
+    }
+
+    fn get(&self, addr: Address<'_>) -> Result<Option<SecretString>> {
+        let (profile, key) = match addr {
+            Address::Convention { profile, key, .. } => (profile.to_string(), key.to_string()),
+            Address::Native(_) => (String::new(), super::flat_item(self, addr)?.into_owned()),
+        };
+        let req = json!({
+            "op": "get",
+            "project": self.config.path.clone().unwrap_or_default(),
+            "profile": profile,
+            "key": key,
+        });
+        let resp = super::block_on(self.dispatch(req))?;
+        match resp.get("value") {
+            Some(v) if v.is_null() => Ok(None),
+            Some(v) if v.is_string() => {
+                let s = v.as_str().unwrap_or("").to_string();
+                Ok(Some(SecretString::new(s.into())))
+            }
+            _ => Err(SecretSpecError::ProviderOperationFailed(format!(
+                "sops response missing 'value' field: {}",
+                resp
+            ))),
+        }
+    }
+
+    fn set(&self, addr: Address<'_>, _value: &SecretString) -> Result<()> {
+        self.check_writable(addr)
+    }
+
+    fn check_writable(&self, _addr: Address<'_>) -> Result<()> {
+        Err(SecretSpecError::ProviderOperationFailed(
+            "SOPS provider is read-only (sops files are immutable); rotate via sops --encrypt + commit".into(),
+        ))
+    }
+}
+
+impl Drop for SopsProvider {
+    /// Graceful subprocess shutdown: send `bye`, flush, wait up to 5s,
+    /// then kill on timeout. Lock via poison-recovery so a panic from
+    /// a prior Mutex holder doesn't cascade into shutdown panic.
+    fn drop(&mut self) {
+        let handle_opt = {
+            let mut guard = recover_lock(self.handle.lock());
+            guard.take()
+        };
+        if let Some(mut handle) = handle_opt {
+            super::block_on(async move {
+                let _ = handle.stdin.write_all(b"{\"op\":\"bye\"}\n").await;
+                let _ = handle.stdin.flush().await;
+                if tokio::time::timeout(
+                    std::time::Duration::from_secs(DISPATCHER_GRACE_SECS),
+                    handle.child.wait(),
+                )
+                .await
+                .is_err()
+                {
+                    let _ = handle.child.kill().await;
+                }
+            });
+        }
+    }
+}
