#!/usr/bin/env bash
# NixOS Cluster Deployment Script
# Deploys configurations to all cluster nodes via SSH
# Uses nixos-rebuild with --target-host for remote deployment

set -e

# Configuration
CURRENT_HOST=$(hostname -s)
BUILD_HOST="nexus"
FLAKE_PATH="/etc/nixos"

# Nodes configuration (use direct IP addresses for SSH)
declare -A NODES
NODES[zephyr]="j_kro@10.1.1.110"
NODES[nexus]="j_kro@10.1.1.120"
NODES[forge]="j_kro@10.1.1.130"
NODES[sentry]="j_kro@10.1.1.140"

  # SSH options
  SSH_OPTS="-o ConnectTimeout=30 -o ServerAliveInterval=60"


log() {
    echo "[$(date '+%H:%M:%S')] $*"
}

prep() {
    log "Copying age key to all nodes..."
    
    # Copy age key to all nodes
    for node in "${!NODES[@]}"; do
        user_host="${NODES[$node]}"
        log "Copying age key to $node ($user_host)..."
        
        ssh $SSH_OPTS "$user_host" "sudo mkdir -p /root/.config/sops/age/ && sudo chmod 700 /root/.config/sops/age/" 2>/dev/null || true
        scp -o ConnectTimeout=30 ~/.config/age/keys.txt "$user_host:/tmp/age-keys.txt" 2>/dev/null || log "WARNING: Could not copy to $node"
        ssh $SSH_OPTS "$user_host" "sudo mv /tmp/age-keys.txt /root/.config/sops/age/keys.txt && sudo chmod 600 /root/.config/sops/age/keys.txt" 2>/dev/null || log "WARNING: Could not set permissions on $node"
        
        log "✓ Age key copied to $node"
    done
    
    log "Age key prep complete. Run 'just deploy' to deploy."
}

push() {
    log "Pushing changes and deploying from current host..."
    
    # Push changes to origin
    log "Pushing to origin/main..."
    cd "$FLAKE_PATH"
    git add -A 2>/dev/null || true
    git commit -m "Cluster update: $(date '+%Y-%m-%d %H:%M')" 2>/dev/null || log "No changes to commit"
    git push origin main 2>/dev/null || log "Push skipped (no changes or remote ahead)"
    
    # Deploy to current host
    local current="${NODES[$CURRENT_HOST]}"
    if [ -n "$current" ]; then
        log "Deploying to $CURRENT_HOST (current host)..."
        sudo nixos-rebuild switch --flake "${FLAKE_PATH}#${CURRENT_HOST}" 2>&1 | tail -50
    fi
}

deploy_node() {
    local node=$1
    local user_host="${NODES[$node]}"

    log "Deploying to $node ($user_host)..."

    if [ "$node" = "$CURRENT_HOST" ]; then
        # Local deployment
        sudo nixos-rebuild switch --flake "${FLAKE_PATH}#${node}" 2>&1 | tail -100
    else
        # Remote deployment via SSH + sudo
        ssh $SSH_OPTS "$user_host" "cd ${FLAKE_PATH} && sudo nixos-rebuild switch --flake '${FLAKE_PATH}#${node}' --use-remote-sudo" 2>&1 | tail -100
    fi
}

build_node() {
    local node=$1
    log "Building $node (dry run)..."
    nix build "${FLAKE_PATH}#nixosConfigurations.${node}.config.system.build.toplevel" --no-link 2>&1
}

show_status() {
    echo "=== CLUSTER STATUS ==="
    echo "zephyr: 10.1.1.110 (Tailscale: 100.81.182.5) - $([ "$CURRENT_HOST" = "zephyr" ] && echo "CURRENT" || echo "remote")"
    echo "nexus:  10.1.1.120 (Tailscale: 100.86.158.18) - $([ "$CURRENT_HOST" = "nexus" ] && echo "CURRENT (build host)" || echo "remote")"
    echo "forge:  10.1.1.130 (Tailscale: 100.116.190.124) - $([ "$CURRENT_HOST" = "forge" ] && echo "CURRENT" || echo "remote")"
    echo "sentry: 10.1.1.140 (Tailscale: 100.82.210.39) - $([ "$CURRENT_HOST" = "sentry" ] && echo "CURRENT" || echo "remote")"
}

show_help() {
    echo "NixOS Cluster Deployment"
    echo ""
    echo "USAGE: $0 <command> [nodes...]"
    echo ""
    echo "COMMANDS:"
    echo "  prep           Copy age key to all nodes (run first!)"
    echo "  push          Push changes + deploy to current host"
    echo "  all           Deploy to all nodes"
    echo "  build         Build all configs (dry run)"
    echo "  status        Show cluster status"
    echo "  zephyr        Deploy to zephyr"
    echo "  nexus         Deploy to nexus"
    echo "  forge         Deploy to forge"
    echo "  sentry        Deploy to sentry"
    echo ""
    echo "EXAMPLES:"
    echo "  $0 prep        # Copy age keys first"
    echo "  $0 all         # Deploy to all nodes"
    echo "  $0 build       # Build all configs without deploying"
    echo ""
    echo "NOTES:"
    echo "  - Remote deployment requires SSH access + sudo on target"
    echo "  - Run 'just prep' before first deployment to all nodes"
    echo "  - Builds run on nexus (build host), deploys via SSH"
}

# Main dispatcher
case "${1:-}" in
    prep)
        prep
        ;;
    push)
        push
        ;;
    deploy|all)
        log "Deploying to all cluster nodes..."
        for node in "${!NODES[@]}"; do
            deploy_node "$node" || log "ERROR: Failed to deploy $node"
        done
        ;;
    build)
        log "Building all configurations..."
        for node in "${!NODES[@]}"; do
            build_node "$node" || log "ERROR: Failed to build $node"
        done
        ;;
    ci|status)
        show_status
        ;;
    update)
        log "Updating flake and deploying to all nodes..."
        cd "$FLAKE_PATH"
        git add -A 2>/dev/null || true
        git commit -m "Cluster update: $(date '+%Y-%m-%d %H:%M')" 2>/dev/null || log "No changes to commit"
        git push origin main 2>/dev/null || log "Push skipped"
        for node in "${!NODES[@]}"; do
            deploy_node "$node" || log "ERROR: Failed to deploy $node"
        done
        ;;
    zephyr|nexus|forge|sentry)
        if [ -n "${NODES[$1]}" ]; then
            deploy_node "$1"
        else
            echo "Unknown node: $1"
            exit 1
        fi
        ;;
    -h|--help|help|"")
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac

log "Done."
