#!/usr/bin/env bash
# NixOS Cluster Deployment Script
# Deploys configurations to all cluster nodes via SSH
# Uses nixos-rebuild with --target-host for remote deployment

set -e

# Configuration
CURRENT_HOST=$(hostname -s)
BUILD_HOST="nexus"
FLAKE_PATH="/etc/nixos"

# Nodes configuration
declare -A NODES
NODES[zephyr]="j_kro@10.1.1.110"
NODES[nexus]="j_kro@10.1.1.120"
NODES[forge]="j_kro@10.1.1.130"
NODES[sentry]="j_kro@10.1.1.140"

# SSH options
SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=5"

log() {
    echo "[$(date '+%H:%M:%S')] $*"
}

deploy_node() {
    local node=$1
    local user_host="${NODES[$node]}"

    log "Deploying to $node ($user_host)..."

    if [ "$node" = "$CURRENT_HOST" ]; then
        # Local deployment
        sudo nixos-rebuild switch --flake "${FLAKE_PATH}#${node}" 2>&1
    else
        # Remote deployment via SSH + sudo
        ssh $SSH_OPTS "$user_host" "cd ${FLAKE_PATH} && sudo nixos-rebuild switch --flake '${FLAKE_PATH}#${node}' --use-remote-sudo" 2>&1
    fi
}

build_node() {
    local node=$1
    log "Building $node (dry run)..."
    nix build "${FLAKE_PATH}#nixosConfigurations.${node}.config.system.build.toplevel" --no-link 2>&1
}

show_status() {
    echo "=== CLUSTER STATUS ==="
    echo "zephyr: 10.1.1.110 (Tailscale: 100.81.182.5) - $([ "$CURRENT_HOST" = "zephyr" ] && echo "CURRENT" || echo "remote")"
    echo "nexus:  10.1.1.120 (Tailscale: 100.86.158.18) - $([ "$CURRENT_HOST" = "nexus" ] && echo "CURRENT (build host)" || echo "remote")"
    echo "forge:  10.1.1.130 (Tailscale: 100.116.190.124) - $([ "$CURRENT_HOST" = "forge" ] && echo "CURRENT" || echo "remote")"
    echo "sentry: 10.1.1.140 (Tailscale: 100.82.210.39) - $([ "$CURRENT_HOST" = "sentry" ] && echo "CURRENT" || echo "remote")"
}

show_help() {
    echo "NixOS Cluster Deployment"
    echo ""
    echo "USAGE: $0 <command> [nodes...]"
    echo ""
    echo "COMMANDS:"
    echo "  all           Deploy to all nodes"
    echo "  build         Build all configs (dry run)"
    echo "  status        Show cluster status"
    echo "  zephyr        Deploy to zephyr"
    echo "  nexus         Deploy to nexus"
    echo "  forge         Deploy to forge"
    echo "  sentry        Deploy to sentry"
    echo ""
    echo "EXAMPLES:"
    echo "  $0 all           # Deploy to all nodes"
    echo "  $0 forge nexus   # Deploy to forge and nexus only"
    echo "  $0 build        # Build all configs without deploying"
    echo ""
    echo "NOTES:"
    echo "  - Remote deployment requires SSH access + sudo on target"
    echo "  - Builds run on nexus (build host), deploys via SSH"
}

# Main dispatcher
case "${1:-}" in
    all)
        log "Deploying to all cluster nodes..."
        for node in "${!NODES[@]}"; do
            deploy_node "$node" || log "ERROR: Failed to deploy $node"
        done
        ;;
    build)
        log "Building all configurations..."
        for node in "${!NODES[@]}"; do
            build_node "$node" || log "ERROR: Failed to build $node"
        done
        ;;
    status)
        show_status
        ;;
    zephyr|nexus|forge|sentry)
        if [ -n "${NODES[$1]}" ]; then
            deploy_node "$1"
        else
            echo "Unknown node: $1"
            exit 1
        fi
        ;;
    -h|--help|help|"")
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac

log "Done."
