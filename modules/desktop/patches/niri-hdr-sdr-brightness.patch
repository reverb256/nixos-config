+    pub fn set_sdr_brightness(&mut self, output: &Output, brightness: f64) -> anyhow::Result<()> {
+        let tty_state = output.user_data().get::<TtyOutputState>().unwrap();
+        let crtc = tty_state.crtc;
+
+        let device = self
+            .devices
+            .get_mut(&tty_state.node)
+            .context("missing device")?;
+        let surface = device.surfaces.get_mut(&crtc).context("missing surface")?;
+
+        let nv_props = surface
+            .nv_brightness_props
+            .as_mut()
+            .context("NV_PLANE_DEGAMMA_MULTIPLIER not available on this output")?;
+
+        // Cannot change properties while the device is inactive.
+        if !self.session.is_active() {
+            surface.pending_nv_brightness = Some(brightness);
+            return Ok(());
+        }
+
+        nv_props.set_brightness(&device.drm, brightness)
+    }
