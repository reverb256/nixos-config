+/// NVIDIA SDR brightness control via NV_PLANE_DEGAMMA_MULTIPLIER plane property.
+///
+/// This property uses a 32.32 fixed-point format where 1.0 = 0x100000000 (4294967296).
+/// It acts as a hardware-accelerated brightness multiplier on the scanout plane,
+/// equivalent to KWin's SDR brightness control for HDR-capable displays.
+struct NvBrightnessProps {
+    plane: plane::Handle,
+    degamma_multiplier: property::Handle,
+    /// Current brightness value (0.0-1.0). Tracked to avoid redundant DRM calls.
+    current: f64,
+}
+
+impl NvBrightnessProps {
+    /// Detect NV_PLANE_DEGAMMA_MULTIPLIER on a plane driving this CRTC.
+    fn new(drm: &DrmDevice, crtc: crtc::Handle) -> Option<Self> {
+        let planes = drm.plane_handles().ok()?;
+
+        for &plane_handle in planes.iter() {
+            let plane_info = match drm.get_plane(plane_handle) {
+                Ok(info) => info,
+                Err(_) => continue,
+            };
+
+            // Check if this plane is currently driving our CRTC.
+            if plane_info.crtc() != Some(crtc) {
+                continue;
+            }
+
+            // Check for NV_PLANE_DEGAMMA_MULTIPLIER on this plane.
+            if let Some((prop_handle, _, _)) =
+                find_drm_property(drm, plane_handle, "NV_PLANE_DEGAMMA_MULTIPLIER")
+            {
+                debug!(
+                    "found NV_PLANE_DEGAMMA_MULTIPLIER on plane {:?} for CRTC {:?}",
+                    plane_handle, crtc
+                );
+                return Some(Self {
+                    plane: plane_handle,
+                    degamma_multiplier: prop_handle,
+                    current: 1.0,
+                });
+            }
+        }
+
+        None
+    }
+
+    /// Set the brightness multiplier (0.0-1.0).
+    fn set_brightness(&mut self, drm: &DrmDevice, brightness: f64) -> anyhow::Result<()> {
+        let brightness = brightness.clamp(0.0, 10.0);
+        if (brightness - self.current).abs() < f64::EPSILON {
+            return Ok(());
+        }
+
+        // Fixed-point 32.32: value = brightness * (1 << 32)
+        let fixed = (brightness * ((1u64 << 32) as f64)) as u64;
+
+        drm.set_property(self.plane, self.degamma_multiplier, fixed)
+            .context("error setting NV_PLANE_DEGAMMA_MULTIPLIER")?;
+
+        self.current = brightness;
+        Ok(())
+    }
+
+    /// Reset brightness to 1.0 (full).
+    fn reset(&mut self, drm: &DrmDevice) -> anyhow::Result<()> {
+        self.set_brightness(drm, 1.0)
+    }
+}
