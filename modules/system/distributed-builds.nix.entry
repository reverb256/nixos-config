        formatMachine = m: with builtins;
          concatStringsSep " " [
            ("ssh-ng:" + "//${m.sshUser}@${m.hostName}")
            m.system
            (if m.sshKey != null then m.sshKey else "-")
            (toString m.maxJobs)
            (toString m.speedFactor)
            (concatStringsSep "," m.supportedFeatures)
            (concatStringsSep "," m.mandatoryFeatures)
          ];
