{
  "dashboard": {
    "title": "Kubernetes API Server Health",
    "description": "Monitor Kubernetes API server health, performance, and restarts",
    "tags": ["kubernetes", "control-plane", "apiserver"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "API Server Uptime",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "time() - process_start_time_seconds{job=\"kube-apiserver-static\"}",
            "legendFormat": "Uptime",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 300, "color": "yellow"},
                {"value": 60, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "API Server Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "up{job=\"kube-apiserver-static\"}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"value": 1, "text": "UP"},
              {"value": 0, "text": "DOWN"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Requests per Second",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(apiserver_request_total{job=\"kube-apiserver-static\"}[5m])) by (verb)",
            "legendFormat": "{{verb}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "req/s"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Request Latency (99th percentile)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(apiserver_request_duration_seconds_bucket{job=\"kube-apiserver-static\"}[5m])) by (le, verb))",
            "legendFormat": "{{verb}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Error Rate (5xx)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "sum(rate(apiserver_request_total{job=\"kube-apiserver-static\",code=~\"5..\"}[5m])) by (code)",
            "legendFormat": "{{code}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "errors/s"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "etcd Request Latency (99th percentile)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(apiserver_storage_db_request_duration_seconds_bucket{job=\"kube-apiserver-static\"}[5m])) by (le, operation_name))",
            "legendFormat": "{{operation_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Active Long-Running Requests",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "sum(apiserver_longrunning_requests{job=\"kube-apiserver-static\"}) by (verb)",
            "legendFormat": "{{verb}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Requests"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Admission Controller Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(apiserver_admission_step_admission_duration_seconds_bucket{job=\"kube-apiserver-static\"}[5m])) by (le, operation_name))",
            "legendFormat": "{{operation_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      }
    ]
  }
}
