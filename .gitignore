# ── Nix ───────────────────────────────────────────────────────────
result

# ── Secrets and keys ──────────────────────────────────────────────
# ✅ DO commit: secrets/*.age (encrypted with age, safe to track)
# ✅ DO commit: secrets/*.yaml (sops-encrypted, safe to track)
# ✅ DO commit: secretspec.toml (only public keys + paths)
# ❌ NEVER commit: plaintext private keys, decrypted files, or raw secrets

# Private keys / certs — ANY file matching these patterns anywhere in the repo
*.pem
*.key
*.crt

# PKI output (generated by modules/pki/gen-certs.sh — never track output)
modules/pki/output/

# Binary cache signing keys
secrets/cache/

# .env files (operator-only, NOT tracked):
#   .env          — local SDK config with SAMSUNG_TV_TOKEN (in secretspec via sops)
#   .env.secrets  — placeholder env map for secretspec dotenv provider
#   .secretspec.env — secretspec pre-loaded env
.env
.env.*
.secretspec.env

# Other plaintext secret patterns
secrets/*.key
secrets/*.plaintext
secrets/*.secret
secrets/*.txt
.age/

