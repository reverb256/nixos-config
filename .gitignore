__pycache__/

# Agenix secrets - Best Practices
# ✅ DO commit: .age files are encrypted and safe to track for reproducibility
# ✅ DO commit: secrets.nix contains only public keys
# ❌ NEVER commit: decrypted files or private keys

# Only ignore decrypted/plaintext variants (if they exist)
secrets/*.key
secrets/*.secret
secrets/*.txt
secrets/*.plaintext

# Never ignore encrypted secrets - they should be tracked
# secrets/*.age
# secrets/secrets.nix
.serena/

# Node.js/npm artifacts (NixOS config should be declarative, not npm-managed)
node_modules/
package-lock.json
package.json
.pnpm-debug.log*
.yarn/*
.yarn-integrity
vllm-env/
