# NixOS Configuration Development Environment
# Automatically loads devShell from flake.nix

set -e  # Exit on any error

# Use the flake devShell
use flake

# Export useful environment variables for the development workflow
export FLAKE_ROOT="$(pwd)"
export NIXOS_CONFIG_DIR="$FLAKE_ROOT"
export COLMENA_CONFIG="$FLAKE_ROOT#"

# Enable colored output for better readability
export NIX_SHOW_STATS=1
export NIX_AUTO_RUN=1

# Set up cache settings for faster builds
export NIX_REMOTE="daemon"
export NIX_SUBSTITUTERS="https://cache.nixos.org/ http://10.1.1.120:9000"

# Enable experimental features that are commonly used
export NIX_EXPERIMENTAL_FEATURES="nix-command flakes"

# Host configuration variables
export ZEPHYR_HOST="10.1.1.110"
export NEXUS_HOST="10.1.1.120"
export FORGE_HOST="10.1.1.130"
export SENTRY_HOST="10.1.1.140"

# ============================================================================
#  ENVIRONMENT VARIABLES
# ============================================================================

#  service ports
export _PORT="18789"
export _API_PORT="18790"

# WiVRn VR streaming
export WIVRN_PORT="9757"
export AVAHI_PORT="5353"

# Security enhancements
# Allow direnv to cache the environment to prevent repeated execution
direnv_layout_dir

# Whitelist specific environment variables to limit what gets exported
export DIRENV_WHITELIST="$FLAKE_ROOT:$FLAKE_ROOT/*"

# Caching optimizations
# Cache the flake evaluation to avoid repeated evaluations
export NIXPKGS_ALLOW_UNFREE=1
export NIXPKGS_ALLOW_INSECURE=1  # Only for development environment

# Load local overrides if they exist (for user-specific settings)
if [[ -f .envrc.local ]]; then
    source .envrc.local
fi
