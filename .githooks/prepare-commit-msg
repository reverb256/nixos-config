#!/usr/bin/env bash
# Git hook: prepare-commit-msg
# Enforces issue reference (#NNN) in commit messages.
# Install: git config core.hooksPath .githooks
#
# Layer 4 of the GitHub Issues Workflow.
# Skipped for merge commits, fixup! and squash! commits.

set -eo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"
SHA1="${3:-}"

# Skip for merges, fixups, squashes
if [[ "$COMMIT_SOURCE" =~ ^(merge|fixup|squash) ]]; then
    exit 0
fi

MSG=$(cat "$COMMIT_MSG_FILE")

# Check if message already has a #NNN reference
if echo "$MSG" | grep -qE '#[0-9]+'; then
    exit 0
fi

# For initial commits or when we can't determine, warn but don't block
if [ -z "$COMMIT_SOURCE" ] || [ "$COMMIT_SOURCE" = "message" ]; then
    echo ""
    echo "⚠️  WARNING: No issue reference (#NNN) found in commit message."
    echo "   Please add one: e.g., 'fix(caddy): resolve TLS handshake timeout (#42)'"
    echo "   To skip this check: git commit --no-verify"
    echo ""
fi
