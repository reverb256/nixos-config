      "ssd"
      "discard=async"
    ];
  };

  # Bind mount for NFS export path (hermes state lives in ~/)
  fileSystems."/data/hermes" = {
    device = "/home/j_kro/.hermes";
    fsType = "none";
    options = ["bind" "rw"];
  };

  # Gammix subvolume mounts for games + projects
  # XPG GAMMIX S11 Pro DIED — redirected to Samsung
  fileSystems."/data/games" = {
    device = "/dev/disk/by-label/root";
    fsType = "btrfs";
    options = ["subvol=@games" "compress=zstd:3" "ssd" "discard=async" "noatime" "nofail"];
  };
  fileSystems."/data/projects" = {
    device = "/dev/disk/by-label/root";
    fsType = "btrfs";
    options = ["subvol=@nix/@projects" "compress=zstd:3" "ssd" "discard=async" "noatime" "nofail"];
  };

  services.nixos-share = {
    enable = false;
  };
